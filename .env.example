# Template, committed. Copy to .env and fill it in; more environments (dev, prod)
# are made from it with `stackup env --create <name>`.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
DATABASE_URL=postgres://app:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017
BIND_ADDR=0.0.0.0:8000
API_URL=https://api.localhost:8443
