# Template, committed. Copy to .env and fill it in; more environments (dev, prod)
# are made from it with `stackup env --create <name>`.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
DATABASE_URL=postgres://app:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/portfolio?directConnection=true
BIND_ADDR=0.0.0.0:8000
API_URL=https://api.localhost:8443
# Uploaded media. `stackup dev` runs the backend in backend/, so this is the repo's data/media.
MEDIA_DIR=../data/media
# Authorises `scripts/upload-media.sh`. Empty disables uploads.
ADMIN_TOKEN=change-me
# Whose GitHub contribution graph to show, read from the public profile. Empty hides it.
GITHUB_USER=your-github-username
# Emails each contact message to NOTIFY_EMAIL, through a Gmail account and its app password
# (Google Account → Security → 2-Step Verification → App passwords). Any empty: messages
# are only stored.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL=you@example.com
# Signs the contact form's "quick check" questions. Empty: a random key each start, which
# only means a question shown before a restart must be answered again.
CHALLENGE_SECRET=
